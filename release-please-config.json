{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bump-minor-pre-major": true,
  "include-v-in-tag": true,
  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "overquid",
      "component": "overquid",
      "include-component-in-tag": false,
      "changelog-path": "CHANGELOG.md",
      "exclude-paths": ["packages/sdk", "packages/create-overlay-plugin"],
      "extra-files": [
        {
          "type": "json",
          "path": "apps/desktop/src-tauri/tauri.conf.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "apps/desktop/package.json",
          "jsonpath": "$.version"
        }
      ],
      "initial-version": "0.1.0"
    },
    "packages/sdk": {
      "release-type": "node",
      "package-name": "@overquid/sdk",
      "component": "sdk",
      "extra-files": [
        {
          "type": "generic",
          "path": "src/index.ts"
        }
      ]
    },
    "packages/create-overlay-plugin": {
      "release-type": "node",
      "package-name": "create-overlay-plugin",
      "component": "create-overlay-plugin",
      "initial-version": "0.1.0"
    }
  },
  "pull-request-title-pattern": "chore(release): release${component} ${version}",
  "group-pull-request-title-pattern": "chore(release): release ${branch}",
  "pull-request-header": "Release prepared by release-please. Merging this pull request tags the release and attaches its packages; keep this header and the --- lines, release-please reads them back."
}
